NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3400
# Optional: enables "Explain this failure" on the replay page.
ANTHROPIC_API_KEY=
# Optional: enables cloud runs. The address `modal deploy cloud/modal_app.py`
# printed for the api function, and the token stored in its shakedown-cloud secret.
SHAKEDOWN_CLOUD_URL=
SHAKEDOWN_CLOUD_TOKEN=
# Optional: the public source repository. Links to it are hidden while empty.
NEXT_PUBLIC_REPO_URL=
